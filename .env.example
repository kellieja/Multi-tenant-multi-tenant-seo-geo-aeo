# ── Required ──────────────────────────────────────────────
DATABASE_URL="postgresql://searchops:searchops@localhost:5432/searchops"
REDIS_URL="redis://localhost:6379"
# Public URL of the web app (used for OAuth redirects and links in emails).
APP_URL="http://localhost:3000"
# 32 random bytes, base64. Encrypts stored integration credentials (AES-256-GCM).
#   openssl rand -base64 32
ENCRYPTION_KEY=""
# 32 random bytes, base64. Used for CSRF/OAuth state signing.
SESSION_SECRET=""

# ── Google (Search Console, GA4) OAuth ───────────────────
# Create an OAuth client (Web application) in Google Cloud Console.
# Redirect URI: ${APP_URL}/api/integrations/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Optional server-wide keys (per-org keys can also be set in Integrations) ──
# PageSpeed Insights works without a key at low volume; a key raises quota.
PAGESPEED_API_KEY=""

# ── Email (notifications, reports, outreach) ─────────────
SMTP_URL=""            # e.g. smtp://user:pass@smtp.example.com:587
EMAIL_FROM=""          # e.g. "SearchOps <reports@example.com>"

# ── Networking ───────────────────────────────────────
# Number of reverse proxies in front of the web app (used to find the real client IP for rate limits).
TRUSTED_PROXY_HOPS="1"

# ── Worker ───────────────────────────────────────────────
CRAWL_CONCURRENCY="2"
WORKER_CONCURRENCY="5"

# ── Crawler ──────────────────────────────────────────────
CRAWLER_USER_AGENT="SearchOpsBot/1.0 (+https://example.com/bot)"
# Only for local development against localhost test sites. NEVER enable in production.
ALLOW_PRIVATE_NETWORK_FETCH="false"

# Set to "true" only in a clearly labelled demo deployment.
DEMO_MODE="false"
