    "clsx": "^2.1.1",
    "cron-parser": "^5.10.2",
    "date-fns": "^4.4.0",
    "geist": "^1.7.2",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.55.0",
    "next": "15.5.27",
    "nodemailer": "^10.1.0",
    "papaparse": "^5.7.0",
    "playwright-core": "1.64.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
